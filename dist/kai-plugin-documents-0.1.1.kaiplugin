{"manifest":{"schema":1,"apiVersion":2,"id":"kai.documents","version":"0.1.1","name":"Documents","description":"Write, organize and revise your local documents. Includes local AI drafting and native text import/export.","entry":"index.html","permissions":["models.read","documents.read","documents.write","documents.import","documents.export","documents.draft"]},"files":{"app.js":"\"use strict\";\nconst $ = id => document.getElementById(id), call = (method, input) => window.kai.call(method, input), model = window.DocumentModel;\nconst banner = window.KaiPluginNotice.attach($(\"message\"), { focusTarget: () => $(\"content\") });\nlet rows = [], current = {}, dirty = false, proposal = \"\", editVersion = 0, documentGeneration = 0, proposalTarget = null, drafting = false, readyModels = false;\nconst actions = {\n  improve: [\"Improve\", \"Improve this text: tighten the wording, fix awkward phrasing, keep the author's voice and meaning.\"],\n  grammar: [\"Fix grammar\", \"Fix spelling, grammar, and punctuation only. Change nothing else about the wording.\"],\n  shorten: [\"Shorten\", \"Rewrite this text at roughly half the length without losing its key points.\"],\n  expand: [\"Expand\", \"Expand this text with more detail and concrete examples, keeping the author's voice.\"],\n  continue: [\"Continue\", \"Continue writing from where this text ends, matching its tone and style. Return ONLY the continuation.\"],\n};\nfunction message(value, error = false) { banner.show(value, { error, force: true }); }\nasync function act(button, fn) { if (button) button.disabled = true; try { return await fn(); } catch (e) { message(e.message, true); } finally { if (button) button.disabled = false; } }\nfunction canLeave() { return !dirty || window.confirm(\"Discard unsaved document changes?\"); }\nfunction clearProposal() { $(\"proposal\").hidden = true; proposal = \"\"; proposalTarget = null; }\nfunction show() {\n  $(\"title\").value = current.title || \"\"; $(\"content\").value = current.content || \"\";\n  $(\"export\").disabled = !current.id; $(\"remove\").disabled = !current.id;\n  dirty = false; editVersion++; documentGeneration++; clearProposal(); status(); draw();\n}\nfunction status() {\n  $(\"status\").textContent = `${model.wordCount($(\"content\").value)} words · ${dirty ? \"Unsaved changes\" : current.id ? \"Saved\" : \"New document\"}`;\n  if (proposalTarget) {\n    const stale = proposalTarget.generation !== documentGeneration || proposalTarget.content !== $(\"content\").value;\n    $(\"apply-draft\").disabled = stale;\n    $(\"proposal-target\").textContent = stale ? \"Document changed · generate a new suggestion\" : proposalTarget.label;\n  }\n}\nfunction draw() {\n  const box = $(\"list\"); box.replaceChildren(); const found = model.filterDocuments(rows, $(\"search\").value);\n  $(\"count\").textContent = `${found.length} document${found.length === 1 ? \"\" : \"s\"}`;\n  if (!found.length) { const empty = document.createElement(\"p\"); empty.textContent = \"Documents you write live here — on this machine, nowhere else.\"; box.append(empty); }\n  for (const doc of found) {\n    const button = document.createElement(\"button\"), title = document.createElement(\"strong\"), preview = document.createElement(\"small\");\n    title.textContent = doc.title; preview.textContent = `${doc.words} words`; button.title = doc.preview || doc.title;\n    button.append(title, preview); button.classList.toggle(\"selected\", doc.id === current.id);\n    button.onclick = () => act(button, async () => { if (!canLeave()) return; const generation = documentGeneration, version = editVersion, loaded = await call(\"documents.get\", { id: doc.id }); if (generation !== documentGeneration || version !== editVersion) return; current = loaded; show(); banner.clear(); });\n    box.append(button);\n  }\n}\nasync function load() {\n  const result = await call(\"documents.list\", {}); rows = result.documents; draw();\n  if (result.errors.length) message(`${result.errors.length} unreadable document(s) were preserved. They were not overwritten.`, true);\n}\n$(\"new\").onclick = () => { if (canLeave()) { current = {}; show(); banner.clear(); $(\"title\").focus(); } }; $(\"search\").oninput = draw;\n$(\"document-form\").oninput = () => { dirty = true; editVersion++; status(); };\n$(\"document-form\").onsubmit = event => {\n  event.preventDefault(); const version = editVersion, generation = documentGeneration;\n  void act(event.submitter, async () => {\n    const saved = await call(\"documents.save\", { id: current.id, revision: current.revision, title: $(\"title\").value, content: $(\"content\").value });\n    if (generation === documentGeneration) {\n      current = saved; $(\"export\").disabled = false; $(\"remove\").disabled = false;\n      if (editVersion === version) dirty = false; status();\n      message(editVersion === version ? \"Document saved.\" : \"Saved the submitted version. Your newer edits are still unsaved.\");\n    }\n    await load();\n  });\n};\n$(\"remove\").onclick = event => act(event.currentTarget, async () => { const generation = documentGeneration, result = await call(\"documents.remove\", { id: current.id, revision: current.revision }); if (!result.cancelled) { if (generation === documentGeneration) { current = {}; show(); } await load(); message(\"Document deleted.\"); } });\n$(\"export\").onclick = event => act(event.currentTarget, async () => { if (dirty) throw Error(\"Save your changes before exporting.\"); const result = await call(\"documents.export\", { id: current.id, revision: current.revision }); if (!result.cancelled) message(`Exported ${result.name}.`); });\n$(\"import\").onclick = event => act(event.currentTarget, async () => { if (!canLeave()) return; const generation = documentGeneration, version = editVersion, result = await call(\"documents.import\", {}); if (!result.cancelled) { if (generation === documentGeneration && version === editVersion) { current = result; show(); } await load(); message(\"Document imported.\"); } });\nfunction draftControls() { for (const button of document.querySelectorAll(\"[data-action],#draft\")) button.disabled = drafting || !readyModels; $(\"model\").disabled = drafting || !readyModels; }\nasync function generate(instruction, label, mode = \"replace\") {\n  if (drafting || !readyModels) return;\n  if (!instruction.trim()) { message(\"Describe what you want to write or change.\", true); return; }\n  const content = $(\"content\").value, start = $(\"content\").selectionStart, end = $(\"content\").selectionEnd, selection = end > start;\n  const target = { generation: documentGeneration, content, start: selection ? start : 0, end: selection ? end : content.length, mode, label: selection ? \"on your selection\" : \"on the whole document\" };\n  const context = content.slice(target.start, target.end);\n  if (instruction.length + context.length > 15000) { message(\"Select a shorter section. Instructions and draft context together must be under 15,000 characters.\", true); return; }\n  clearProposal(); drafting = true; draftControls(); $(\"draft-status\").textContent = \"Preparing suggestion with your local model…\";\n  try {\n    const result = await call(\"documents.draft\", { model: $(\"model\").value, prompt: instruction, content: context });\n    if (documentGeneration !== target.generation) return;\n    proposal = result.text; proposalTarget = target; $(\"draft-text\").textContent = proposal;\n    $(\"proposal-label\").textContent = label; $(\"proposal\").hidden = false; status();\n  } catch (error) { if (documentGeneration === target.generation) message(error.message, true); }\n  finally { drafting = false; draftControls(); $(\"draft-status\").textContent = \"Suggestions use a local model. Apply, then Save, to keep your changes.\"; }\n}\n$(\"draft\").onclick = () => { void generate($(\"prompt\").value, \"Suggestion\"); };\n$(\"prompt\").onkeydown = event => { if (event.key === \"Enter\" && !event.isComposing) { event.preventDefault(); void generate(event.target.value, \"Suggestion\"); } };\nfor (const button of document.querySelectorAll(\"[data-action]\")) button.onclick = () => { const [label, instruction] = actions[button.dataset.action]; void generate(instruction, label, button.dataset.action === \"continue\" ? \"append\" : \"replace\"); };\n$(\"apply-draft\").onclick = () => {\n  try {\n    if (!proposalTarget || proposalTarget.generation !== documentGeneration) throw Error(\"This suggestion belongs to another document. Generate a new suggestion.\");\n    $(\"content\").value = model.applySuggestion($(\"content\").value, proposal, proposalTarget);\n    dirty = true; editVersion++; clearProposal(); status(); message(\"Suggestion applied to the editor. Save when ready.\");\n  } catch (error) { message(error.message, true); }\n};\n$(\"discard-draft\").onclick = clearProposal; $(\"close-proposal\").onclick = clearProposal;\nshow(); draftControls();\nvoid act(null, async () => {\n  await load(); const list = await call(\"models.list\");\n  for (const item of list.filter(item => item.status === \"ready\")) { const option = document.createElement(\"option\"); option.value = item.alias; option.textContent = item.label || item.alias; $(\"model\").append(option); }\n  readyModels = !!$(\"model\").options.length;\n  if (!readyModels) { const option = document.createElement(\"option\"); option.textContent = \"Install a local model in KAI Core first\"; $(\"model\").append(option); }\n  draftControls();\n});\n","brand-mark.svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\"><defs><linearGradient id=\"blue\" x2=\".8\" y2=\"1\"><stop stop-color=\"#03cefa\"/><stop offset=\"1\" stop-color=\"#0856f9\"/></linearGradient></defs><g fill=\"none\" stroke=\"url(#blue)\" stroke-width=\"11\" stroke-linecap=\"round\"><path d=\"M11 10v7M11 38V28L35 9M26 29l12 10\"/></g></svg>\n","index.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Documents</title><link rel=\"stylesheet\" href=\"kai-theme.css\"><link rel=\"stylesheet\" href=\"style.css\"></head>\n<body>\n<header class=\"workspace-header\"><div class=\"workspace-heading\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M14 3H5v18h14V8ZM14 3v5h5M8 12h8M8 16h6\"/></svg><h1>Documents</h1></div><div class=\"actions\"><button type=\"button\" id=\"export\">Export</button><button type=\"button\" id=\"remove\" class=\"danger\">Delete</button><button class=\"primary\" id=\"save\" type=\"submit\" form=\"document-form\">Save</button></div></header>\n<div id=\"message\" role=\"status\" hidden></div>\n<div class=\"docs-layout\">\n<aside class=\"docs-side\"><div class=\"docs-side-head\"><span>Documents</span><button id=\"new\" class=\"linklike\">+ New</button></div><label class=\"sr-only\" for=\"search\">Find a document</label><input id=\"search\" type=\"search\" placeholder=\"Find a document…\"><div id=\"list\" aria-label=\"Saved documents\"></div><div class=\"docs-side-footer\"><span id=\"count\" class=\"muted\"></span><button id=\"import\" class=\"linklike\">Import text</button></div></aside>\n<main class=\"docs-main\"><form id=\"document-form\"><label for=\"title\" class=\"sr-only\">Document title</label><input id=\"title\" maxlength=\"200\" placeholder=\"Title\"><label for=\"content\" class=\"sr-only\">Document</label><textarea id=\"content\" maxlength=\"1000000\" placeholder=\"Write here. Select some text (or nothing, for the whole document) and use the AI bar below — suggestions preview first, and only Apply changes your words.\" spellcheck=\"true\"></textarea><div class=\"docs-status\"><span id=\"status\" role=\"status\"></span></div></form>\n<details id=\"assistant\" open><summary class=\"sr-only\">Write with local AI</summary><div class=\"docs-ai-bar\"><label class=\"sr-only\" for=\"model\">Model for suggestions</label><select id=\"model\" title=\"Model for suggestions\"></select><button class=\"doc-act\" data-action=\"improve\">Improve</button><button class=\"doc-act\" data-action=\"grammar\">Fix grammar</button><button class=\"doc-act\" data-action=\"shorten\">Shorten</button><button class=\"doc-act\" data-action=\"expand\">Expand</button><button class=\"doc-act\" data-action=\"continue\">Continue</button><label class=\"sr-only\" for=\"prompt\">Custom writing instruction</label><input id=\"prompt\" maxlength=\"12000\" placeholder=\"…or tell it what to do (e.g. “make this friendlier”)\"><button id=\"draft\" class=\"doc-act\">Go</button></div><p id=\"draft-status\" class=\"muted\" role=\"status\">Suggestions use a local model. Apply, then Save, to keep your changes.</p></details>\n<section id=\"proposal\" hidden><div class=\"doc-suggest-head\"><span id=\"proposal-label\">Suggestion</span><span id=\"proposal-target\" class=\"muted\"></span><button type=\"button\" id=\"close-proposal\" class=\"close-button\" aria-label=\"Dismiss suggestion\" title=\"Dismiss suggestion\"><span aria-hidden=\"true\">×</span></button></div><pre id=\"draft-text\"></pre><div class=\"doc-suggest-actions\"><button id=\"apply-draft\" class=\"primary\">Apply</button><button id=\"discard-draft\">Discard</button></div></section>\n</main></div><script src=\"kai-notices.js\"></script><script src=\"model.js\"></script><script src=\"app.js\"></script></body></html>\n","kai-notices.js":"\"use strict\";\n(function (root) {\n  const attached = new WeakMap();\n  function attach(container, { focusTarget } = {}) {\n    if (attached.has(container)) return attached.get(container);\n    const document = container.ownerDocument, initial = container.textContent;\n    const message = document.createElement(\"span\"), close = document.createElement(\"button\"), symbol = document.createElement(\"span\");\n    message.className = \"kai-notice-text\"; message.setAttribute(\"role\", \"status\"); message.setAttribute(\"aria-atomic\", \"true\");\n    close.className = \"kai-notice-close\"; close.type = \"button\"; close.title = \"Dismiss message\"; close.setAttribute(\"aria-label\", \"Dismiss message\");\n    symbol.textContent = \"×\"; symbol.setAttribute(\"aria-hidden\", \"true\"); close.append(symbol);\n    container.classList.add(\"kai-notice\"); container.removeAttribute(\"role\"); container.removeAttribute(\"aria-live\"); container.replaceChildren(message, close);\n    let current = \"\", dismissed = null;\n    function show(value, { error = false, dismissible = true, force = false } = {}) {\n      const content = String(value ?? \"\"), key = JSON.stringify([content, error, dismissible]);\n      if (force || key !== current) dismissed = null;\n      current = key;\n      if (message.textContent !== content) message.textContent = content;\n      container.classList.toggle(\"error\", error); close.hidden = !dismissible;\n      container.hidden = !content || current === dismissed;\n    }\n    function dismiss() {\n      if (container.hidden || close.hidden) return;\n      const hadFocus = document.activeElement === close;\n      dismissed = current; container.hidden = true;\n      if (hadFocus) {\n        const target = focusTarget?.();\n        if (target && !target.disabled && target.getClientRects().length) target.focus({ preventScroll: true });\n      }\n    }\n    close.onclick = dismiss;\n    const api = { show, dismiss, clear() { show(\"\"); } };\n    attached.set(container, api); show(initial);\n    return api;\n  }\n  root.KaiPluginNotice = { attach };\n})(window);\n","kai-theme.css":"/* KAI workspace primitives, shared by the first-party plugin windows. */\n:root{color-scheme:light;--bg:#f4f7fd;--bg-raised:#fff;--bg-input:#f5f8fe;--panel:#fff;--surface:#fff;--border:#dce5f2;--line:#dce5f2;--text:#14284e;--text-dim:#61728d;--muted:#61728d;--accent:#155eef;--violet:#155eef;--sky:#096bdc;--emerald:#168469;--mint:#168469;--danger:#c93d4c;--radius:14px;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:var(--text);background:var(--bg)}\n*{box-sizing:border-box;scrollbar-width:thin;scrollbar-color:#bdcde2 #f4f7fd}\n*::-webkit-scrollbar{width:9px;height:9px}*::-webkit-scrollbar-track,*::-webkit-scrollbar-corner{background:#f4f7fd}*::-webkit-scrollbar-thumb{background:#bdcde2;border:2px solid #f4f7fd;border-radius:8px}*::-webkit-scrollbar-thumb:hover{background:#9eb4d1}\nbody{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{border:1px solid var(--border);border-radius:9px;background:#fff;color:var(--text);padding:9px 14px;font-size:12px;font-weight:550;cursor:pointer;transition:background .15s,border-color .15s}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:650}button.primary:hover:not(:disabled){background:#0c4ed3;border-color:#0c4ed3}\ninput,select,textarea{background:var(--bg-input);border:1px solid var(--border);border-radius:9px;padding:10px 12px;color:var(--text);max-width:100%;font-size:12px}input::placeholder,textarea::placeholder{color:#8795aa}textarea{resize:vertical}label{font-size:12px;color:var(--text-dim)}a{color:var(--accent)}p{font-size:12px;line-height:1.7}h1,h2,h3{line-height:1.4;font-weight:600}h1{font-size:24px;letter-spacing:-.5px}h2{font-size:16px;letter-spacing:-.2px}h3{font-size:13px}.muted,.hint,.small{color:var(--text-dim);font-size:11px;line-height:1.6}\n:where(.workspace-header,.kai-workspace-header){display:flex;align-items:center;gap:12px;min-height:74px;height:74px;flex:none;border-bottom:1px solid var(--border);padding:0 28px;background:var(--bg)}:where(.workspace-header,.kai-workspace-header) h1{font-size:15px;letter-spacing:0;margin:0;font-weight:650}:where(.workspace-header,.kai-workspace-header) svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n.kai-notice{display:flex;align-items:flex-start;gap:12px;min-width:0;padding:10px 13px;border:1px solid #c6d9f9;border-radius:10px;background:#eaf2ff;color:#184b9c;font-size:12px;line-height:1.6;overflow-wrap:anywhere}.kai-notice.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}.kai-notice-text{flex:1;min-width:0;align-self:center;max-height:30vh;overflow:auto;white-space:pre-wrap}.kai-notice .kai-notice-close{display:flex;align-items:center;justify-content:center;flex:0 0 30px;width:30px;height:30px;padding:0;border:0;border-radius:6px;background:transparent;color:inherit;font-size:22px;line-height:1}.kai-notice .kai-notice-close:hover{background:#14284e12}\n[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(max-width:700px){:where(.workspace-header,.kai-workspace-header){padding-inline:18px;min-height:65px;height:65px}}\n@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}\n","model.js":"\"use strict\";\n(function(root){const api={filterDocuments(rows,query){const q=String(query||\"\").trim().toLowerCase();return rows.filter(d=>!q||`${d.title} ${d.preview}`.toLowerCase().includes(q));},wordCount(value){const t=String(value||\"\").trim();return t?t.split(/\\s+/).length:0;},applySuggestion(content,proposal,target){if(typeof proposal!==\"string\"||proposal.length>1000000)throw Error(\"Invalid proposed draft\");if(!target||content!==target.content||!Number.isInteger(target.start)||!Number.isInteger(target.end)||target.start<0||target.end<target.start||target.end>content.length||![\"append\",\"replace\"].includes(target.mode))throw Error(\"The document changed. Generate a new suggestion before applying.\");const next=target.mode===\"append\"?content.slice(0,target.end)+(target.end>0&&!/\\s$/.test(content.slice(0,target.end))?\" \":\"\")+proposal+content.slice(target.end):content.slice(0,target.start)+proposal+content.slice(target.end);if(next.length>1000000)throw Error(\"The resulting document is too large\");return next;},applyProposal(doc,proposal){if(typeof proposal!==\"string\"||proposal.length>1000000)throw Error(\"Invalid proposed draft\");return {...doc,content:proposal};}};if(typeof module===\"object\")module.exports=api;else root.DocumentModel=api;})(typeof window===\"undefined\"?globalThis:window);\n","style.css":"/* Preserve the original Documents list, writing canvas and inline AI toolbar. */\n:root{color-scheme:light;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;--bg:#f4f7fd;--surface:#fff;--line:#dce5f2;--text:#14284e;--muted:#61728d;--accent:#155eef;--danger:#c93d4c;background:var(--bg);color:var(--text)}\n*{box-sizing:border-box}body{margin:0;height:100dvh;min-height:500px;display:flex;flex-direction:column;overflow:hidden}button,input,select,textarea{font:inherit}button{font-size:12px;padding:9px 13px;border:1px solid var(--line);border-radius:9px;background:var(--surface);color:var(--text);cursor:pointer}button:hover:enabled{background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:default}.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:600}.primary:hover:enabled{background:#0c4ed3;border-color:#0c4ed3}.danger{color:var(--danger)}input,select,textarea{min-width:0;color:var(--text);background:#f5f8fe;border:1px solid var(--line);border-radius:9px;padding:10px 12px;font-size:12px}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:3px}h1,p{margin:0}.muted{font-size:11px;color:var(--muted)}.actions{display:flex;align-items:center;gap:8px}.workspace-header{height:74px;min-height:74px;display:flex;align-items:center;justify-content:space-between;gap:18px;border-bottom:1px solid var(--line);background:var(--bg);padding:0 30px}.workspace-heading{display:flex;align-items:center;gap:10px}.workspace-heading h1{font-size:15px;line-height:1.4;font-weight:650}.workspace-heading svg{width:20px;height:20px;fill:none;stroke:var(--accent);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.workspace-header button{font-size:11px;padding:7px 11px}\n.docs-layout{flex:1;display:flex;min-height:0}.docs-side{width:208px;flex-shrink:0;border-right:1px solid #e2eaf5;background:#fafcff;padding:20px 14px;display:flex;flex-direction:column;min-height:0}.docs-side-head{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:14px;padding:0 4px}.linklike{padding:4px;background:none;border:0;color:var(--accent);font-weight:500;font-size:11px;white-space:nowrap}.linklike:hover:enabled{background:transparent;text-decoration:underline}.docs-side>input{width:100%;margin:0 0 14px;padding:9px 10px;font-size:11px;background:#fff}#list{overflow:auto;flex:1;min-height:0}#list>button{display:block;text-align:left;width:100%;border:1px solid transparent;background:transparent;padding:10px;margin:0 0 3px;border-radius:8px}#list>button:hover{background:#f0f5fd}#list>button.selected{background:#eaf2ff;color:var(--accent)}#list strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;font-weight:600}#list small{display:block;font-size:10px;color:var(--muted);margin-top:4px;line-height:1.6;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}#list>p{padding:8px 4px;font-size:11px;line-height:1.7;color:var(--muted)}.docs-side-footer{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12px 3px 0;margin-top:12px;border-top:1px solid var(--line)}.docs-side-footer .muted{font-size:10px}\n.docs-main{flex:1;min-width:0;display:flex;flex-direction:column;padding:30px 5% 20px;gap:10px;background:#fff;overflow:auto}#document-form{display:flex;flex-direction:column;gap:12px;flex:1;min-height:220px}#title{background:none;border:0;border-radius:0;color:var(--text);font:inherit;font-size:29px;letter-spacing:-.8px;font-weight:650;padding:0 2px;width:100%}#content{flex:1;resize:none;background:none;border:0;border-radius:0;color:#2c4568;font:inherit;font-size:14px;line-height:1.9;padding:0 2px;width:100%;min-height:120px}#title:focus-visible,#content:focus-visible{outline:1px solid #b7cff6;outline-offset:5px}.docs-status{display:flex;align-items:center;gap:14px;font-size:11px;color:#617590;min-height:18px}#status{white-space:normal}.docs-ai-bar{display:flex;gap:7px;align-items:center;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:18px}.docs-ai-bar select{background:#f5f8fe;padding:7px 9px;font-size:11px;max-width:180px;flex:0 1 180px}.doc-act{padding:7px 10px;font-size:11px;background:#fff}.docs-ai-bar #prompt{flex:1;min-width:180px;padding:7px 10px;font-size:11px}.docs-ai-bar #draft{flex:none}#assistant{flex:none}#draft-status{margin:8px 0 0;font-size:10px;line-height:1.6}#proposal{border:1px solid #a9c6f8;border-radius:12px;background:#fff;max-height:42%;min-height:180px;display:flex;flex-direction:column;flex:none}.doc-suggest-head{display:flex;align-items:center;gap:12px;padding:9px 14px;border-bottom:1px solid var(--line);font-size:12px;font-weight:650}.doc-suggest-head .muted{margin-left:auto;font-size:10px;font-weight:400}.close-button{border:0;background:transparent;color:var(--muted);padding:0;width:28px;height:28px;font-size:22px;line-height:1;flex:none}#draft-text{padding:12px 14px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.7;font:inherit;font-size:12px;margin:0;flex:1;min-height:0}.doc-suggest-actions{display:flex;gap:8px;padding:10px 14px;border-top:1px solid var(--line)}.doc-suggest-actions button{padding:7px 12px;font-size:11px}#message{margin:12px 30px 0;font-size:12px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}[hidden]{display:none!important}\n@media(max-width:900px){.docs-side{width:185px}.docs-main{padding:26px 24px 18px}.workspace-header{padding:0 24px}.docs-ai-bar select{max-width:150px}#title{font-size:26px}}\n@media(max-width:650px){.workspace-header{height:65px;min-height:65px;padding:0 16px}.workspace-header .actions{gap:5px}.workspace-header button{padding:6px 8px;font-size:10px}.docs-side{width:145px;padding:17px 9px}.docs-main{padding:22px 16px 16px}.docs-side-head{padding:0;font-size:9px;letter-spacing:.04em}.docs-side-footer{flex-wrap:wrap}.docs-ai-bar{gap:5px}.docs-ai-bar select{max-width:100%;flex:1 1 100%}.docs-ai-bar #prompt{min-width:120px}.doc-act{font-size:10px;padding:6px 8px}#title{font-size:24px}#content{font-size:13px}#message{margin-inline:16px}.doc-suggest-head{padding:8px 10px;gap:8px}.doc-suggest-head .muted{font-size:9px}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"DV0D/YHJS9lxYiLyHLIicw46NK+WprAq3L2r7SYKM/ilW656qAflEk8/Yw0WxxyX739dK1XAhDzIjjz5AHT4CA=="}