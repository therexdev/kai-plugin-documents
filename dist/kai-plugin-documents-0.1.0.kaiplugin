{"manifest":{"schema":1,"apiVersion":2,"id":"kai.documents","version":"0.1.0","name":"Documents","description":"Write, organize and revise your local documents. Includes local AI drafting and native text import/export.","entry":"index.html","permissions":["models.read","documents.read","documents.write","documents.import","documents.export","documents.draft"]},"files":{"app.js":"\"use strict\";\nconst $=id=>document.getElementById(id),call=(m,i)=>window.kai.call(m,i),model=window.DocumentModel;\nlet rows=[],current={},dirty=false,proposal=\"\",editVersion=0;\nfunction message(v,error=false){$(\"message\").textContent=v;$(\"message\").hidden=false;$(\"message\").classList.toggle(\"error\",error);}\nasync function act(b,fn){if(b)b.disabled=true;try{return await fn();}catch(e){message(e.message,true);}finally{if(b)b.disabled=false;}}\nfunction canLeave(){return !dirty||window.confirm(\"Discard unsaved document changes?\");}\nfunction show(){ $(\"title\").value=current.title||\"\";$(\"content\").value=current.content||\"\";$(\"export\").disabled=!current.id;$(\"remove\").disabled=!current.id;dirty=false;editVersion++;$(\"proposal\").hidden=true;status();draw();}\nfunction status(){$(\"status\").textContent=`${model.wordCount($(\"content\").value)} words · ${dirty?\"Unsaved changes\":current.id?\"Saved\":\"New document\"}`;}\nfunction draw(){const box=$(\"list\");box.replaceChildren();const found=model.filterDocuments(rows,$(\"search\").value);$(\"count\").textContent=`${found.length} document${found.length===1?\"\":\"s\"}`;if(!found.length){const p=document.createElement(\"p\");p.textContent=\"No documents found. Start a new draft or import a text file.\";box.append(p);}for(const d of found){const b=document.createElement(\"button\"),title=document.createElement(\"strong\"),preview=document.createElement(\"small\");title.textContent=d.title;preview.textContent=d.preview||`${d.words} words`;b.append(title,preview);b.classList.toggle(\"selected\",d.id===current.id);b.onclick=()=>act(b,async()=>{if(!canLeave())return;current=await call(\"documents.get\",{id:d.id});show();});box.append(b);}}\nasync function load(){const r=await call(\"documents.list\",{});rows=r.documents;draw();if(r.errors.length)message(`${r.errors.length} unreadable document(s) were preserved. They were not overwritten.`,true);}\n$(\"new\").onclick=()=>{if(canLeave()){current={};show();$(\"title\").focus();}};$(\"search\").oninput=draw;\n$(\"document-form\").oninput=()=>{dirty=true;editVersion++;status();};\n$(\"document-form\").onsubmit=e=>{e.preventDefault();const version=editVersion;void act(e.submitter,async()=>{const saved=await call(\"documents.save\",{id:current.id,revision:current.revision,title:$(\"title\").value,content:$(\"content\").value});current=saved;if(editVersion===version){dirty=false;status();}await load();message(editVersion===version?\"Document saved.\":\"Saved the submitted version. Your newer edits are still unsaved.\");});};\n$(\"remove\").onclick=e=>act(e.currentTarget,async()=>{const r=await call(\"documents.remove\",{id:current.id,revision:current.revision});if(!r.cancelled){current={};show();await load();message(\"Document deleted.\");}});\n$(\"export\").onclick=e=>act(e.currentTarget,async()=>{if(dirty)throw Error(\"Save your changes before exporting.\");const r=await call(\"documents.export\",{id:current.id,revision:current.revision});if(!r.cancelled)message(`Exported ${r.name}.`);});\n$(\"import\").onclick=e=>act(e.currentTarget,async()=>{if(!canLeave())return;const r=await call(\"documents.import\",{});if(!r.cancelled){current=r;show();await load();message(\"Document imported.\");}});\n$(\"draft\").onclick=e=>act(e.currentTarget,async()=>{const content=$(\"content\").value;if(content.length>16000)throw Error(\"AI drafting supports up to 16,000 characters of existing draft. Shorten the context before generating.\");const r=await call(\"documents.draft\",{model:$(\"model\").value,prompt:$(\"prompt\").value,content});proposal=r.text;$(\"draft-text\").textContent=proposal;$(\"proposal\").hidden=false;message(\"Proposal ready. Review it before replacing your current draft.\");});\n$(\"apply-draft\").onclick=()=>{const next=model.applyProposal(current,proposal);$(\"content\").value=next.content;dirty=true;editVersion++;status();$(\"proposal\").hidden=true;message(\"Proposal applied to the editor. Save when ready.\");};\n$(\"discard-draft\").onclick=()=>{$(\"proposal\").hidden=true;proposal=\"\";};\nvoid act(null,async()=>{await load();const list=await call(\"models.list\");for(const m of list.filter(m=>m.status===\"ready\")){const o=document.createElement(\"option\");o.value=m.alias;o.textContent=m.label||m.alias;$(\"model\").append(o);}if(!$(\"model\").options.length){$(\"draft\").disabled=true;const o=document.createElement(\"option\");o.textContent=\"Install a local model in KAI Core first\";$(\"model\").append(o);}show();});\n","index.html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Documents</title><link rel=\"stylesheet\" href=\"style.css\"></head><body><header><div><div class=\"eyebrow\">A SPACE FOR YOUR IDEAS</div><h1>Documents</h1><p>Write, refine and keep your work on this computer.</p></div><div class=\"actions\"><button id=\"import\">Import text</button><button id=\"new\" class=\"primary\">New document</button></div></header><div id=\"message\" role=\"status\" hidden></div><div class=\"toolbar\"><label class=\"sr-only\" for=\"search\">Find a document</label><input id=\"search\" type=\"search\" placeholder=\"Find a document…\"><span id=\"count\" class=\"muted\"></span></div><div class=\"workspace\"><section id=\"list\" aria-label=\"Saved documents\"></section><article><form id=\"document-form\"><label for=\"title\">Title</label><input id=\"title\" maxlength=\"200\" placeholder=\"Untitled\"><label for=\"content\">Document</label><textarea id=\"content\" rows=\"18\" maxlength=\"1000000\" placeholder=\"Start writing…\"></textarea><div class=\"actions\"><button class=\"primary\" id=\"save\">Save document</button><button type=\"button\" id=\"export\">Export</button><button type=\"button\" id=\"remove\">Delete</button><span id=\"status\" class=\"muted\"></span></div></form><hr><details id=\"assistant\"><summary>Write with local AI</summary><p class=\"muted\">Choose an installed model. Generated text is a proposal; it is only saved when you apply it and save the document.</p><label for=\"model\">Local model</label><select id=\"model\"></select><label for=\"prompt\">What would you like to write or change?</label><textarea id=\"prompt\" rows=\"3\" maxlength=\"12000\" placeholder=\"Write an introduction, revise the structure, or improve clarity…\"></textarea><button id=\"draft\">Generate proposal</button><section id=\"proposal\" hidden><h2>Proposed draft</h2><pre id=\"draft-text\"></pre><div class=\"actions\"><button id=\"apply-draft\" class=\"primary\">Use this draft</button><button id=\"discard-draft\">Discard proposal</button></div></section></details></article></div><script src=\"model.js\"></script><script src=\"app.js\"></script></body></html>\n","model.js":"\"use strict\";\n(function(root){const api={filterDocuments(rows,query){const q=String(query||\"\").trim().toLowerCase();return rows.filter(d=>!q||`${d.title} ${d.preview}`.toLowerCase().includes(q));},wordCount(value){const t=String(value||\"\").trim();return t?t.split(/\\s+/).length:0;},applyProposal(doc,proposal){if(typeof proposal!==\"string\"||proposal.length>1000000)throw Error(\"Invalid proposed draft\");return {...doc,content:proposal};}};if(typeof module===\"object\")module.exports=api;else root.DocumentModel=api;})(typeof window===\"undefined\"?globalThis:window);\n","style.css":":root{font:15px/1.55 Inter,Segoe UI,system-ui,sans-serif;color-scheme:dark;background:#10151e;color:#ecf1f8;--muted:#99a9bf;--line:#2c3849;--accent:#b3edce}*{box-sizing:border-box}body{max-width:1440px;margin:auto;padding:32px 38px}header{display:flex;justify-content:space-between;align-items:center;gap:24px;margin-bottom:24px}h1{font-size:38px;letter-spacing:-1px;margin:7px 0}h2{font-size:21px;margin:10px 0}p{color:var(--muted);margin:8px 0 16px}.eyebrow{color:var(--accent);font-size:11px;font-weight:700;letter-spacing:2px}.stats{display:flex;gap:12px;margin-bottom:24px}.stats span{padding:9px 14px;border:1px solid var(--line);border-radius:30px;color:var(--muted);font-size:12px}nav{display:flex;gap:6px;border-bottom:1px solid var(--line);padding-bottom:12px}button,input,textarea,select{font:inherit;border:1px solid var(--line);border-radius:9px;padding:10px 13px}button{background:#202c3d;color:#e9eff8;cursor:pointer;font-size:13px;font-weight:650}button:hover{background:#304157}button.active{background:#344a43;color:var(--accent);border-color:#568a70}.primary{background:var(--accent);border-color:var(--accent);color:#183425}.primary:hover{background:#d4ffe7}button:disabled{opacity:.5;cursor:wait}input,textarea,select{background:#101722;color:#eef3fc;width:100%;margin:6px 0 18px}textarea{resize:vertical;line-height:1.6}label{font-size:12px;color:var(--muted)}.toolbar{display:flex;gap:12px;margin:20px 0}.toolbar input{margin:0;max-width:520px}.workspace{display:grid;grid-template-columns:minmax(230px, .8fr) minmax(360px,1.6fr);gap:22px}article{background:#171f2c;border:1px solid var(--line);border-radius:15px;padding:25px;min-height:440px}#list{display:grid;align-content:start;gap:10px;max-height:70vh;overflow:auto}#list button{display:block;text-align:left;width:100%;padding:16px;background:#171f2c}#list button.selected{border-color:#8dbda6;background:#20302f}#list strong{display:block;font-size:15px}#list small{display:block;color:var(--muted);font-size:12px;font-weight:400;margin-top:6px;overflow-wrap:anywhere}.columns{display:grid;grid-template-columns:1fr 1fr;gap:14px}.actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.check{display:flex;gap:8px;align-items:center;margin-bottom:15px}.check input{width:auto;margin:0;accent-color:var(--accent)}.muted{font-size:12px;color:var(--muted)}#message{padding:12px 16px;border:1px solid #577766;border-radius:10px;background:#21362d;margin-bottom:20px}#message.error{border-color:#a66572;background:#3e272e}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}[hidden]{display:none!important}:focus-visible{outline:2px solid var(--accent);outline-offset:2px}pre{white-space:pre-wrap;overflow-wrap:anywhere}hr{border:0;border-top:1px solid var(--line);margin:20px 0}@media(max-width:800px){body{padding:22px}.workspace{grid-template-columns:1fr}#list{max-height:32vh}header{align-items:flex-start}.columns{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"LDrXJhM8UgR8wnneSOGmJthtbhf6jNwBKVhNUdjjjN9brepcYmlo+BKTlPFXLVs4Fe7q/2NWKcNSDGtmTe9pAg=="}